{
  "name": "mohammad-bayu-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "styles:build": "tailwindcss -i ./app/globals.css -o ./public/site.css",
    "dev": "npm run styles:build && next dev",
    "dev:windows": "npm run styles:build && next dev --webpack",
    "build": "npm run styles:build && next build",
    "build:windows": "npm run styles:build && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^16.2.6",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.19.25",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  }
}
